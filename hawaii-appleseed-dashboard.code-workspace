{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"terminal.integrated.profiles.windows": {
			"PowerShell - Auto Activate Env": {
				"source": "PowerShell",
				"args": [
					"-NoExit",
					"-Command",
					"if (Test-Path 'venv\\Scripts\\Activate.ps1') { .\\venv\\Scripts\\Activate.ps1 } else { Write-Host 'Virtual environment not found. Run .\\Activate.ps1 to create one.' -ForegroundColor Yellow }"
				],
				"overrideName": true
			}
		},
		"terminal.integrated.defaultProfile.windows": "PowerShell - Auto Activate Env"
	}
}